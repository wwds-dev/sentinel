# Sentinel Fork — API keys
# Paste your keys after the '=' (no quotes). Leave blank to disable that provider.
# This file lives in ~/Library/Application Support/Sentinel Fork/.env for the packaged app.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Alibaba Qwen (Model Studio / DashScope). Key from bailian.console.alibabacloud.com
DASHSCOPE_API_KEY=
# Optional — defaults to the international endpoint. Set this for a mainland
# China account (https://dashscope.aliyuncs.com/compatible-mode/v1) or a
# workspace-scoped regional host.
# Leave unset for the international endpoint; set only for the China-region endpoint.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── OSINT / dark-web exposure sources ──────────────────────────────────────
# HaveIBeenPwned — email breach and paste records ($3.50/mo). Key at
# haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Intelligence X — dark-web / leak index used by Trace's Exposure Check and
# Bloodhound. Paid API (its free public keys were discontinued); leave blank to
# skip it. ransomware.live and Ahmia need no key. Key at
# intelx.io/account?tab=developer
INTELX_API_KEY=
# OpenSanctions — sanctions, politically exposed persons and watchlists, used by
# Trace's company Live Research and Bloodhound's organisation targets. Every API
# call needs a key; the data is free for non-commercial use, commercial use needs
# their licence. Leave blank to skip it. Key at opensanctions.org/api
OPENSANCTIONS_API_KEY=
# IPinfo — IP geolocation, network owner, and (paid plans) VPN/proxy/hosting/Tor
# flags. Used by the IP lookup (skipped there unless this key is set — IPinfo
# refuses anonymous access) and the Tunnel panel's public-IP readout (which falls
# back to ipapi.co without a key). Free tier available. Key at ipinfo.io/signup
IPINFO_API_KEY=
# Criminal IP — IP reputation: risk scoring, VPN/proxy/Tor/hosting flags, open
# ports and the network owner. Used by the IP lookup, which skips it unless this
# key is set. Free tier (limited credits). Key at criminalip.io
# (My Information → API Key).
CRIMINALIP_API_KEY=
# DeHashed — breach exposure: which leak databases an email or domain appears in.
# Used by Trace's Exposure Check and Bloodhound, and skipped unless this key is
# set. Sentinel surfaces only breach names and counts — never leaked passwords or
# hashes. Paid (credit-metered). Key at dehashed.com (Account → API).
DEHASHED_API_KEY=
# CourtListener (Free Law Project) — U.S. federal and state court dockets by
# party/organisation name, from the RECAP archive. Used by Trace's and
# Bloodhound's company/organisation lookups; works anonymously, so a key is
# optional and only raises the rate limit. Sentinel reads docket metadata only —
# never document text or PDFs. Free. Key at courtlistener.com/profile/api-token
COURTLISTENER_API_KEY=
# addy.io — email-alias service. Used only by the "Mint alias" button in the
# OSINT Keys tab to create a fresh burner address for operational registrations;
# nothing runs automatically, and it is skipped unless this key is set. Free tier
# available. Key at app.addy.io (Settings → API).
ADDYIO_API_KEY=
#
# ── Threat intelligence for Trace's and Bloodhound's domain / IP lookups ──────
# Each is skipped until its key is set, and Trace's consent prompt names every
# one that will receive the target. Code: providers/intel_sources.py.
#
# AbuseIPDB — community abuse reports and a 0–100 confidence score, for IPs.
# Free: 1,000 checks a day. Use the APIv2 key (it differs from the old v1 key).
# Key at abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# GreyNoise — is an IP mass-scanning the internet, or a known benign service.
# Community API; free accounts get 50 lookups a week, and webmail-registered
# accounts get no key. Key at viz.greynoise.io/account
GREYNOISE_API_KEY=
# VirusTotal — security-vendor verdicts for IPs and domains. Free: 4 a minute,
# 500 a day, non-commercial use only; every lookup is added to VirusTotal's
# dataset. The key is 64 hex characters. Key at virustotal.com (profile → API key)
VIRUSTOTAL_API_KEY=
# AlienVault OTX — community threat reports (pulses) naming an IP or domain.
# Free. Key at otx.alienvault.com/api
OTX_API_KEY=
# Shodan — with a key, IP lookups get the full host record (service banners,
# CVEs) and domain lookups list subdomains (1 query credit each; free accounts
# have none). Without it Sentinel still uses the free InternetDB summary.
# Key at account.shodan.io
SHODAN_API_KEY=
# Censys — a Platform personal access token (not the retired Search API ID and
# secret). Free: 100 host lookups a month. Paid organisations also set the
# organisation ID. Token at platform.censys.io (Account → Personal access tokens)
CENSYS_API_KEY=
CENSYS_ORG_ID=
# SecurityTrails — current DNS and subdomain count for a domain; one query per
# domain lookup. Free plan allows about 50 a month. Key at securitytrails.com
SECURITYTRAILS_API_KEY=
# DomainTools — domain profile and risk score, whichever your plan includes.
# Save as username:api_key (or set the username below) so requests are
# HMAC-signed and the key never travels. Paid. Key at research.domaintools.com
DOMAINTOOLS_API_KEY=
DOMAINTOOLS_API_USERNAME=
# URLScan — optional. Raises the username search quota (about 100 a day without
# a key, 1,000 with a free one) and adds recent scans of a domain to domain
# lookups. Key at urlscan.io/user/profile
URLSCAN_API_KEY=
# Hunter — a domain's email pattern and role addresses (security@, info@), and a
# mail-server check for an email address. Named people's addresses are never
# requested; only their count is shown. Free: 50 credits a month. Key at
# hunter.io/api-keys
HUNTER_API_KEY=
#
# ── Breach databases for Trace's Exposure Check and Bloodhound ───────────────
# Same rule as DeHashed: breach names, record counts and kinds of leaked data
# only, never the leaked values.
#
# Snusbase — asked through its count-only endpoint, so no record is downloaded.
# Paid. Key (activation code, starts with "sb") at snusbase.com
SNUSBASE_API_KEY=
# LeakCheck — breaches with dates and the kinds of data leaked. Paid plan
# required for the API. Key at leakcheck.io (Settings → API)
LEAKCHECK_API_KEY=
