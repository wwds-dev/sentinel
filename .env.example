# Sentinel Fork — API keys
# Paste your keys after the '=' (no quotes). Leave blank to disable that provider.
# This file lives in ~/Library/Application Support/Sentinel Fork/.env for the packaged app.

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Alibaba Qwen (Model Studio / DashScope). Key from bailian.console.alibabacloud.com
DASHSCOPE_API_KEY=
# Optional — defaults to the international endpoint. Set this for a mainland
# China account (https://dashscope.aliyuncs.com/compatible-mode/v1) or a
# workspace-scoped regional host.
DASHSCOPE_BASE_URL=

# ── OSINT / dark-web exposure sources ──────────────────────────────────────
# HaveIBeenPwned — email breach and paste records ($3.50/mo). Key at
# haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Intelligence X — dark-web / leak index used by Trace's Exposure Check and
# Bloodhound. Paid API (its free public keys were discontinued); leave blank to
# skip it. ransomware.live and Ahmia need no key. Key at
# intelx.io/account?tab=developer
INTELX_API_KEY=
# OpenSanctions — sanctions, politically exposed persons and watchlists, used by
# Trace's company Live Research and Bloodhound's organisation targets. Every API
# call needs a key; the data is free for non-commercial use, commercial use needs
# their licence. Leave blank to skip it. Key at opensanctions.org/api
OPENSANCTIONS_API_KEY=
# IPinfo — IP geolocation, network owner, and (paid plans) VPN/proxy/hosting/Tor
# flags. Used by the IP lookup (skipped there unless this key is set — IPinfo
# refuses anonymous access) and the Tunnel panel's public-IP readout (which falls
# back to ipapi.co without a key). Free tier available. Key at ipinfo.io/signup
IPINFO_API_KEY=
# Criminal IP — IP reputation: risk scoring, VPN/proxy/Tor/hosting flags, open
# ports and the network owner. Used by the IP lookup, which skips it unless this
# key is set. Free tier (limited credits). Key at criminalip.io
# (My Information → API Key).
CRIMINALIP_API_KEY=
# DeHashed — breach exposure: which leak databases an email or domain appears in.
# Used by Trace's Exposure Check and Bloodhound, and skipped unless this key is
# set. Sentinel surfaces only breach names and counts — never leaked passwords or
# hashes. Paid (credit-metered). Key at dehashed.com (Account → API).
DEHASHED_API_KEY=
# CourtListener (Free Law Project) — U.S. federal and state court dockets by
# party/organisation name, from the RECAP archive. Used by Trace's and
# Bloodhound's company/organisation lookups; works anonymously, so a key is
# optional and only raises the rate limit. Sentinel reads docket metadata only —
# never document text or PDFs. Free. Key at courtlistener.com/profile/api-token
COURTLISTENER_API_KEY=
# addy.io — email-alias service. Used only by the "Mint alias" button in the
# OSINT Keys tab to create a fresh burner address for operational registrations;
# nothing runs automatically, and it is skipped unless this key is set. Free tier
# available. Key at app.addy.io (Settings → API).
ADDYIO_API_KEY=
